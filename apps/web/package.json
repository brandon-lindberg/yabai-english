    "@tanstack/react-table": "^8.21.3",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.3.4",
    "hast-util-sanitize": "^5.0.2",
    "lexical": "^0.35.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
