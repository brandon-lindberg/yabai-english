{
  "name": "@english-platform/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node --max-old-space-size=256 --max-semi-space-size=2 node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:english-placement": "vitest run --config vitest.english-placement.config.ts",
    "test:english-placement:db": "tsx scripts/test-mirror-migration.ts --english-placement",
    "test:unit": "vitest run",
    "test:japanese-content": "vitest run --config vitest.japanese-content.config.ts",
    "test:japanese-placement": "vitest run --config vitest.japanese-placement.config.ts",
    "test:japanese-placement:db": "tsx scripts/test-mirror-migration.ts --japanese-placement",
    "test:japanese-placement:e2e": "playwright test --config playwright.japanese-placement.config.ts",
    "japanese-placement:audit": "node --conditions=react-server --import tsx scripts/audit-japanese-placement.ts",
    "japanese-placement:content": "node --conditions=react-server --import tsx scripts/audit-japanese-placement-content.ts",
