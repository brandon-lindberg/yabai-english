    "placement-bank:audit": "tsx scripts/audit-placement-bank.ts",
    "placement-bank:report-quality": "tsx scripts/report-placement-bank-quality.ts",
    "placement-bank:report-full": "tsx scripts/report-placement-full-audit.ts",
