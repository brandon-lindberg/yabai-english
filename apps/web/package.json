    "study:build-beginner1-json": "tsx scripts/build-beginner1-json.ts",
    "study:build-beginner2-json": "tsx scripts/build-beginner2-json.ts",
    "study:build-beginner3-json": "tsx scripts/build-beginner3-json.ts",
    "study:build-intermediate1-json": "tsx scripts/build-intermediate1-json.ts",
    "study:build-intermediate2-json": "tsx scripts/build-intermediate2-json.ts",
    "study:build-intermediate3-json": "tsx scripts/build-intermediate3-json.ts",
    "study:build-advanced1-json": "tsx scripts/build-advanced1-json.ts",
    "study:build-advanced2-json": "tsx scripts/build-advanced2-json.ts",
    "study:build-advanced3-json": "tsx scripts/build-advanced3-json.ts",
    "chat:repair-scope": "tsx scripts/repair-chat-message-scope.ts",
    "db:seed": "prisma db seed",
    "test:study": "vitest run --config vitest.study.config.ts",
    "test:study:db": "node --import tsx scripts/test-mirror-migration.ts --study",
    "japanese-content:study": "node --import tsx scripts/import-japanese-study.ts",
    "japanese-content:deploy": "node --conditions=react-server --import tsx scripts/deploy-japanese-content.ts",
    "japanese-content:prompts": "node --conditions=react-server --import tsx scripts/audit-japanese-study-prompts.ts",
    "japanese-content:review": "node --import tsx scripts/review-japanese-study-content.ts",
    "payments:recover": "node --conditions=react-server --import tsx scripts/recover-payments.ts",
    "test:domains:db": "node --import tsx scripts/test-mirror-migration.ts --domains",
    "test:domains:e2e": "yarn test:mirror:e2e --domains --synthetic-draft",
    "test:payments:db": "node --import tsx scripts/test-mirror-migration.ts --payments"
